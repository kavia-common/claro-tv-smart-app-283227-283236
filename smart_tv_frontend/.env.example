# Environment variables used by the smart TV frontend
# Do NOT commit a real .env with secrets/URLs – this is just a template.

REACT_APP_API_BASE=
# or alternatively:
REACT_APP_BACKEND_URL=

# Optional, reserved for future features:
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
